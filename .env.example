# PDFnik - root .env
# Copy to .env and fill in real values. Never commit .env to git.

# ---- Telegram Bot ----
BOT_TOKEN=

# ---- RabbitMQ ----
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# ---- Redis ----
REDIS_URL=redis://pdfbot_redis:6379/0

# ---- Whisper transcription ----
# Model options (speed vs accuracy):
#   tiny      - fastest, lowest accuracy
#   base      - good balance for short clips (default)
#   small     - better accuracy, ~2x slower
#   medium    - high accuracy, ~4x slower
#   large-v3  - best accuracy, needs more RAM/VRAM
# For Russian speech: large-v3 with GPU, base/small on CPU.
TRANSCRIBE_MODEL=base
TRANSCRIBE_DEVICE=cpu
TRANSCRIBE_COMPUTE_TYPE=int8
TRANSCRIBE_THREADS=4
TRANSCRIBE_WORKERS=1
TRANSCRIBE_BEAM_SIZE=5
TRANSCRIBE_PATIENCE=1.0
TRANSCRIBE_VAD=false
TRANSCRIBE_LANG=auto

# ---- LLM summary (optional, disabled by default) ----
# Uncomment and configure one provider to enable YouTube transcript summarization.
# SUMMARY_PROVIDER=disabled      # disabled | anthropic | openai | ollama
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# SUMMARY_MAX_CHARS=6000

# ---- Files cleaner ----
FILES_ROOT=/data_files_storage
IMAGES_TTL_HOURS=1
PDF_TTL_HOURS=24
CHECK_INTERVAL_SECONDS=600
LOG_LEVEL=INFO
# ONESHOT=true    # run once and exit, useful for testing

# ---- Service build paths (optional) ----
# By default docker compose looks for service directories relative to this file.
# Set these only if your directory layout differs from the standard structure.
# Standard layout (no need to set these):
#   ./PDFnik-Backend, ./PDFnik-TelegramBot, ./PDFnik-files_cleaner
PDF_SERVICE_PATH=/full/path/to/PDFnik/PDFnik-Backend
FILES_CLEANER_PATH=/full/path/to/PDFnik/PDFnik-files_cleaner
TELEGRAM_BOT_PATH=/full/path/to/PDFnik/PDFnik-TelegramBot
